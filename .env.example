# Copia este archivo como .env para desarrollo local (npm run dev lo lee solo).
# En producción define estas variables en el panel de tu plataforma.

# Conexión a MySQL: mysql://usuario:contraseña@host:3306/base_de_datos
DATABASE_URL=mysql://ksinito:cambia-esta-clave@127.0.0.1:3306/ksinito
# Pon 1 si tu proveedor exige conexión cifrada (TiDB Cloud, PlanetScale, Aiven…)
DATABASE_SSL=0

# Secreto de las sesiones (32+ caracteres). Si no lo pones, se genera uno y se guarda en MySQL.
JWT_SECRET=

PORT=3000
# 1 en producción con HTTPS
COOKIE_SECURE=0
