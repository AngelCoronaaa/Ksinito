# Copia este archivo como .env para desarrollo local (npm run dev lo lee solo).
# En producción define estas variables en el panel de tu plataforma.

# Conexión a MySQL: mysql://usuario:contraseña@host:3306/base_de_datos
DATABASE_URL=mysql://ksinito:cambia-esta-clave@127.0.0.1:3306/ksinito
# Pon 1 si tu proveedor exige conexión cifrada (TiDB Cloud, PlanetScale, Aiven…)
DATABASE_SSL=0

# Secreto de las sesiones (32+ caracteres). Si no lo pones, se genera uno y se guarda en MySQL.
JWT_SECRET=

# Límite de cuentas nuevas (0 = sin límite; en desarrollo conviene 0 en ambos).
ACCOUNTS_PER_DEVICE=2
ACCOUNTS_PER_IP=3
ACCOUNTS_IP_WINDOW_HOURS=24
# Cabecera con la IP real del jugador (Cloudflare). Déjala vacía si no usas Cloudflare.
CLIENT_IP_HEADER=cf-connecting-ip

# Servidores STUN/TURN para las cámaras y el chat de voz del blackjack (JSON). Por defecto, el STUN público de Google.
# Para jugadores en datos móviles o redes corporativas añade un TURN, por ejemplo:
# RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.tu-dominio.com:3478","username":"usuario","credential":"clave"}]
RTC_ICE_SERVERS=

PORT=3000
# 1 en producción con HTTPS
COOKIE_SECURE=0
